{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "jsx": "react-jsx",
  "include": ["shared/**/*.ts", "server/**/*.ts", "client/**/*.ts", "index.server.ts", "index.client.tsx", "tests/**/*.ts"]
}
